#!/bin/sh
# Commit-msg hook: conventional commit format + release gate footer.
# Installed through `pnpm hooks:install` (git config core.hooksPath .githooks).
root=$(git rev-parse --show-toplevel) || exit 0
command -v node >/dev/null 2>&1 || exit 0
exec node "$root/scripts/dev/check-commit.mjs" message "$1"
